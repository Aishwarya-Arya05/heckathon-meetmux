# ──────────────────────────────────────────────
# Supply Chain Delay Risk – Environment Config
# Copy to .env and fill in real values.
# ──────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret

# ── Backend ──────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
BACKEND_LOG_LEVEL=info

# ── Neo4j ────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# ── Routing Provider ─────────────────────────
# Options: "osrm_self_hosted" | "osrm_public_demo" | "mock"
ROUTE_PROVIDER=mock
# Only used when ROUTE_PROVIDER=osrm_self_hosted
OSRM_BASE_URL=http://localhost:5000
# Request timeout in seconds
ROUTE_TIMEOUT_SECONDS=10

# ── Map Tiles ────────────────────────────────
# Options: "osm" | "mapbox" | "custom"
MAP_TILE_PROVIDER=osm
# Only used when MAP_TILE_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
# Only used when MAP_TILE_PROVIDER=custom
CUSTOM_TILE_URL=
CUSTOM_TILE_ATTRIBUTION=

# ── Delay Prediction ────────────────────────
# Path to the trained model artifact (.joblib)
MODEL_ARTIFACT_PATH=
# When empty or invalid, the service returns fallback estimates
MODEL_VERSION=

# ── Auth (integration point) ─────────────────
# Set to "true" to enable auth middleware
AUTH_ENABLED=false
AUTH_JWKS_URL=
AUTH_AUDIENCE=
AUTH_ISSUER=

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Frontend (injected at build time) ────────
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_TILE_PROVIDER=osm
VITE_MAPBOX_TOKEN=
