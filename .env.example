# ============================================================
# Supply Chain Shipment Delay Risk & Route Planning System
# Environment Configuration
# ============================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env — only .env.example belongs in version control.
# ============================================================

# ---------- Application ----------
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=info
APP_SECRET_KEY=change-me-to-a-random-secret

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# ---------- Routing Provider ----------
# Options: "osrm" | "demo"
ROUTING_PROVIDER=demo
# For self-hosted or licensed OSRM instance (NOT the public demo server)
OSRM_BASE_URL=http://localhost:5000
OSRM_TIMEOUT_SECONDS=10

# ---------- Map Tiles ----------
# Options: "osm" | "mapbox" | "custom"
MAP_TILE_PROVIDER=osm
# Required only when MAP_TILE_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
# Required only when MAP_TILE_PROVIDER=custom
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=

# ---------- Delay Prediction Model ----------
# Path to a trained model artifact (.joblib). Leave empty to use fallback estimator.
MODEL_ARTIFACT_PATH=
MODEL_VERSION=

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Auth (integration point) ----------
# AUTH_PROVIDER=none
# AUTH_JWKS_URL=
# AUTH_AUDIENCE=
# AUTH_ISSUER=

# ---------- Rate Limiting ----------
RATE_LIMIT_PER_MINUTE=60

# ---------- PostgreSQL (optional, if operational persistence is separated) ----------
# DATABASE_URL=postgresql://user:password@localhost:5432/supplychain
